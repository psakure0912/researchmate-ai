# ============================================
# ResearchMate AI - Environment Configuration
# Copy to backend/.env and frontend/.env.local
# NEVER commit real secrets to version control!
# ============================================

# --------------------
# FRONTEND (Next.js)
# --------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --------------------
# BACKEND (FastAPI)
# --------------------
ENVIRONMENT=development
APP_NAME=ResearchMate AI API
CORS_ORIGINS=http://localhost:3000

# Supabase (Backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=research-papers

# Google Gemini LLM
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# RAG & Vector Database (ChromaDB)
# Options for EMBEDDING_PROVIDER: "gemini" (low RAM, production-friendly) or "sentence_transformers"
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Options for CHROMA_MODE: "persistent" (local/mounted disk), "http" (remote Chroma), or "cloud" (Chroma Cloud)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=researchmate_chunks
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# File Upload Limits
MAX_UPLOAD_SIZE_MB=25

# External Academic APIs
# Semantic Scholar works without a key at public rate limits; add key for higher throughput
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_CONTACT_EMAIL=researchmate@example.com
